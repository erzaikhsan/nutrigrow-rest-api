# ── Database ────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/nutrigrow?schema=public"

# ── Aplikasi ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Autentikasi ─────────────────────────────────────────────────────────────
# WAJIB minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN=24h

# Masa aktif akun sejak pendaftaran, dalam tahun.
ACCOUNT_ACTIVE_YEARS=5

# ── Pengiriman email OTP ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nutrigrowapp@gmail.com
SMTP_PASSWORD="app-password-google-16-karakter"
SMTP_FROM_NAME=NutriGrow

# ── CORS ────────────────────────────────────────────────────────────────────
# Daftar origin dipisah koma. Kosongkan untuk mengizinkan semua (khusus dev).
CORS_ORIGINS=
